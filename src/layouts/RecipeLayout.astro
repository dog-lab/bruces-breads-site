---
// Real chrome, ported from website/recipes/*.html + the shared
// website/styles.css. /styles.css and /logo_v2_cropped.jpg are served
// from the public/ folder at the site root.
import Header from '../components/Header.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Bruce's Breads</title>
  <link rel="canonical" href={Astro.url.href} />
  <link rel="stylesheet" href="/styles.css" />
  <style is:global>
    /* is:global on purpose: the recipe content below (title block, hero,
       tables, etc.) is passed in via <slot/> from src/pages/recipes/[slug].astro,
       and Astro only auto-scopes CSS to elements rendered by *this* component's
       own template -- slotted content from the parent page doesn't get the
       scoping attribute, so a normal scoped <style> here would silently not
       match any of it. is:global opts out of that scoping so these rules
       apply the way they visually should. */
    body { line-height: 1.6; }
    nav a:hover { color: var(--tomato); }
    footer { margin-top: 40px; }
    .recipe-hero { position: relative; }
    .recipe-hero img { width: 100%; max-height: 480px; object-fit: cover; display: block; }
    .recipe-title-block { text-align: center; padding: 36px 6% 10px; max-width: 900px; margin: 0 auto; }
    .recipe-title-block h1 { color: var(--crust); font-size: 2.6rem; margin: 0 0 8px; }
    .recipe-title-block .subtitle { font-style: italic; color: #5c4a37; font-size: 1.15rem; }
    main { max-width: 900px; margin: 0 auto; padding: 0 6% 60px; }
    section.block { margin-top: 56px; }
    h2 { color: var(--crust); font-size: 1.9rem; border-bottom: 3px solid var(--egg-wash); padding-bottom: 8px; }
    h3 { color: var(--crust); font-size: 1.3rem; margin-top: 28px; }
    h4 { color: var(--tomato); margin-bottom: 6px; }
    table { width: 100%; border-collapse: collapse; margin: 18px 0; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #eee0c8; }
    th { background: var(--egg-wash); color: var(--dark-text); }
    tr:last-child td { border-bottom: none; }
    ul, ol { padding-left: 22px; }
    li { margin-bottom: 8px; }
    figure { margin: 20px 0; }
    figure img { width: 100%; border-radius: 14px; box-shadow: 0 4px 14px rgba(0,0,0,0.1); display: block; }
    .callout { background: #fff; border-left: 4px solid var(--tomato); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 16px 0; }
    .printable-extras { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    .pdf-pill { background: var(--tomato); color: #fff; padding: 6px 14px; border-radius: 20px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .pdf-pill:hover { opacity: 0.9; }
    .playlist-group { margin-bottom: 22px; }
    .playlist-group h4 { margin-bottom: 4px; }
    .back-link { display: inline-block; margin: 28px 6% 0; color: var(--tomato); text-decoration: none; font-weight: 600; }
    .back-link:hover { text-decoration: underline; }

    /* Table overflow safety net: word-break is the actual guard against a
       stray long token forcing horizontal page overflow -- normal text
       wraps fine on its own (confirmed on every table on the site,
       including the 4-column Inclusions table with a prose Notes column,
       at a 380px viewport). An earlier version of this rule also set
       table { display: block; overflow-x: auto; } as a belt-and-suspenders
       scroll fallback, but that turned out to actively cause a bug rather
       than prevent one: setting display:block directly on <table> breaks
       the browser's unified column-width algorithm across rows, so a
       short-content table (the 2-column Estimated Nutrition table was the
       one that showed it) can end up with its header row a different
       width than its body rows, since each row is now free to size itself
       independently instead of sharing one set of column widths. Caught
       via a real-phone check (Samsung Galaxy S25 Ultra) August 2026 --
       removed rather than patched further, since nothing on the site
       actually needs the scroll fallback in the first place. */
    td, th { word-break: break-word; }
    @media (max-width: 700px) {
      main { padding: 0 5% 50px; }
      .recipe-title-block { padding: 28px 5% 8px; }
      .recipe-title-block h1 { font-size: 1.9rem; }
      .recipe-title-block .subtitle { font-size: 1rem; }
      .recipe-hero img { max-height: 260px; }
      h2 { font-size: 1.5rem; }
      h3 { font-size: 1.15rem; }
      th, td { padding: 8px 10px; font-size: 0.92rem; }
      .printable-extras { justify-content: center; text-align: center; }
    }
  </style>
</head>
<body>

  <Header />

  <a class="back-link" href="/#menu">&larr; Back to the menu</a>

  <slot />

  <footer>
    <p>Bruce's Breads &middot; Fresh Bread, Fresh Puns, Zero Hair</p>
    <div class="signature">Bread proudly brought to you by Bruce the Bald Baker</div>
    <div class="fine-print">&copy; 2026 Bruce's Breads. All rights reserved.</div>
  </footer>

</body>
</html>

---
import { getCollection, render } from 'astro:content';
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import EchoThread from '../../components/EchoThread.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const {
  title, subtitle, heroImage, cardFilePrefix,
  dough, hydrationSaltNote, inclusions, yieldNote,
  flatlayImage, flatlayAlt,
  nonstandardIngredients, nonstandardIngredientsNote,
  allergens, nutritionBasis, nutritionCaveat, nutritionFacts, vitamins, nutritionNote,
  equipment, playlist, booksMovies,
} = recipe.data;
---
<RecipeLayout title={title}>
  <div class="recipe-title-block">
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>

  <div class="recipe-hero">
    <img src={heroImage} alt={title} />
  </div>

  <main>

    <div class="callout printable-extras">
      <strong>Printable extras:</strong>
      <a href={`/cards/${cardFilePrefix}_Recipe_Card.pdf`} class="pdf-pill">Recipe Card (PDF)</a>
      <a href={`/cards/${cardFilePrefix}_Steps_Card.pdf`} class="pdf-pill">Steps Card (PDF)</a>
      <a href={`/cards/${cardFilePrefix}_Nutrition_Card.pdf`} class="pdf-pill">Nutrition Card (PDF)</a>
    </div>

    <section class="block" id="recipe-card">
      <h2>Recipe Card</h2>

      <h3>Dough Ingredients</h3>
      <table>
        <tr><th>Ingredient</th><th>Weight (g)</th><th>Baker's %</th></tr>
        {dough.map((row) => (
          <tr style={row.isTotal ? 'font-weight:bold;' : ''}>
            <td>{row.name}</td>
            <td>{row.weight}</td>
            <td>{row.percent}</td>
          </tr>
        ))}
      </table>
      {hydrationSaltNote && <p><strong>A note on hydration and salt:</strong> {hydrationSaltNote}</p>}

      {inclusions.length > 0 && (
        <>
          <h3>Inclusions</h3>
          <table>
            <tr><th>Inclusion</th><th>Weight (g)</th><th>Baker's %</th><th>Notes</th></tr>
            {inclusions.map((row) => (
              <tr style={row.isTotal ? 'font-weight:bold;' : ''}>
                <td>{row.name}</td>
                <td>{row.weight}</td>
                <td>{row.percent}</td>
                <td>{row.notes}</td>
              </tr>
            ))}
          </table>
        </>
      )}
      <p>{yieldNote}</p>

      {flatlayImage && <figure><img src={flatlayImage} alt={flatlayAlt} /></figure>}

      <h3>Notes on Nonstandard Ingredients</h3>
      {nonstandardIngredients.length > 0 ? (
        <ul>
          {nonstandardIngredients.map((item) => (
            <li><strong>{item.ingredient}:</strong> {item.note}</li>
          ))}
        </ul>
      ) : (
        nonstandardIngredientsNote && <p>{nonstandardIngredientsNote}</p>
      )}

      <h3>Estimated Nutrition</h3>
      <div class="allergen-box">
        {allergens.length > 0 ? (
          <>
            <p class="allergen-head">&#9888; Contains</p>
            <ul>
              {allergens.map((a) => <li>{a}</li>)}
            </ul>
          </>
        ) : (
          <>
            <p class="allergen-head">&#9888; Allergens</p>
            <p>No major allergens (milk, eggs, fish, shellfish, tree nuts, peanuts, wheat, soybeans, sesame) in this recipe as written &mdash; always confirm against the labels of the specific brands you use.</p>
          </>
        )}
      </div>
      <p><strong>Basis:</strong> {nutritionBasis}. {nutritionCaveat}</p>
      <table>
        <tr><th>Nutrient</th><th>Amount</th></tr>
        {nutritionFacts.map((f) => (
          <tr><td>{f.label}</td><td>{f.amount}</td></tr>
        ))}
      </table>
      <p><strong>Notable Vitamins &amp; Minerals:</strong></p>
      <ul>
        {vitamins.map((v) => (
          <li><b>{v.ingredient}:</b> {v.description}</li>
        ))}
      </ul>
      {nutritionNote && <p>{nutritionNote}</p>}

      <h3>Equipment</h3>
      <ul>
        {equipment.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {/*
      Everything from here on -- any prep-ahead component, the full
      Step-by-Step Tutorial Script (with its pH-check callouts), Alternatives
      and Improvements, Troubleshooting/FAQ (as a raw HTML table), Ingredient
      History Story, and Bloopers -- comes from the Markdown body in that
      exact order. See the comment in content.config.ts for why this stays
      body content rather than structured fields.
    */}
    <section class="block">
      <Content />
    </section>

    <section class="block">
      <h2>Baking Music Playlist</h2>
      {playlist.map((phase) => (
        <div class="playlist-group">
          <h4>{phase.phase}</h4>
          <ul>
            {phase.tracks.map((t) => (
              <li>{t.artist} — "{t.track}" ({t.album}, {t.year})</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="block">
      <h2>If You Like This Bake, You Might Like These Books &amp; Movies</h2>
      {booksMovies.map((group) => (
        <div class="playlist-group">
          <h4>{group.groupTitle}</h4>
          <ul>
            {group.items.map((item) => (
              <li><b>{item.title}</b> — {item.note}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <EchoThread
      pageId={recipe.id}
      pageTitle={title}
      pageUrl={Astro.url.href}
    />

  </main>
</RecipeLayout>

<style>
  .allergen-box {
    border: 2px solid #d9503f;
    border-radius: 6px;
    background: rgba(217, 80, 63, 0.09);
    padding: 0.6rem 0.9rem;
    margin: 0.75rem 0 1rem;
  }
  .allergen-box p { margin: 0; }
  .allergen-box .allergen-head {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85em;
    color: #b23a2c;
    margin-bottom: 0.25rem;
  }
  .allergen-box ul { margin: 0; padding-left: 1.2rem; }
  .allergen-box li { font-weight: 700; }
</style>

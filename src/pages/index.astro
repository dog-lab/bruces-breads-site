---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';

const recipes = await getCollection('recipes');
const stories = (await getCollection('sami')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const recentStories = stories.slice(0, 2);

// Recipes that are baked, approved, and written up in full, but deliberately
// kept out of the `recipes` content collection because their nutrition/dough
// tables aren't finished yet (see each stub page for why). Added here by
// hand, one line per recipe, so they're still discoverable from the
// homepage instead of only reachable through a Guides cross-link. Aug 15,
// 2026 nav restructure. Empty as of Sept 15, 2026 -- Brioche Base and
// Laminated Pastry Base both graduated to full recipes (Well Bread and
// Build Block Butter) and their stub pages now point there directly, so
// there's nothing left to tease here. The section below hides itself
// automatically when this list is empty; add entries back the same way
// if a future base recipe needs a "baking soon" placeholder again.
const comingSoon: { image: string; title: string; teaser: string; href: string }[] = [];

// Bread-type menu structure decided August 3, 2026 (see CLAUDE.md's
// "Recipe menu structure (categories)"). Only sections that actually have
// a published recipe get a heading -- an empty section just doesn't render,
// so a still-empty section (Discards, Gluten Free) will pick up a heading
// automatically the moment its first recipe ships, no template change
// needed. Everyday Bakes is no longer deferred/empty as of Two Irons, One
// Fire (Aug) and Breadwinner (Sept 15) -- update this note if CLAUDE.md's
// "deferred" language for it hasn't been cleaned up too.
const SECTION_ORDER = [
  'classics',
  'enriched-sweet',
  'pastry-lamination',
  'discards',
  'gluten-free',
  'everyday-bakes',
] as const;
const SECTION_LABELS: Record<string, string> = {
  'classics': 'The Classics',
  'enriched-sweet': 'Enriched & Sweet',
  'pastry-lamination': 'Pastry & Lamination',
  'discards': 'Discards',
  'gluten-free': 'Gluten Free',
  'everyday-bakes': 'Everyday Bakes',
};
const recipesBySection = SECTION_ORDER.map((section) => ({
  section,
  label: SECTION_LABELS[section],
  items: recipes.filter((r) => r.data.section === section),
})).filter((group) => group.items.length > 0);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bruce's Breads — Sourdough So Good It's Almost Suspicious</title>
  <link rel="canonical" href={Astro.url.href} />
  <link rel="stylesheet" href="/styles.css" />
  <style>
    nav a:hover { color: #5c4a37; }

    .hero {
      position: relative;
      height: 78vh;
      min-height: 460px;
      overflow: hidden;
    }
    .hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.7);
    }
    .hero-text {
      position: absolute;
      top: 50%;
      left: 6%;
      transform: translateY(-50%);
      color: #fff;
      max-width: 600px;
    }
    .hero-text h1 {
      font-size: 3rem;
      margin: 0 0 12px;
      text-shadow: 2px 2px 6px rgba(0,0,0,0.5);
    }
    .hero-text p {
      font-size: 1.25rem;
      margin: 0 0 24px;
      text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
    }
    section {
      padding: 30px 6%;
      max-width: 1100px;
      margin: 0 auto;
    }
    #about {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    #about .section-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 15px 6%;
    }
    .tagline-banner {
      background: var(--egg-wash);
      text-align: center;
      padding: 14px;
      font-weight: bold;
      color: var(--dark-text);
      font-size: 1.05rem;
    }
    h2 {
      text-align: center;
      color: var(--crust);
      font-size: 2.2rem;
      margin-top: 8px;
    }
    .subhead {
      text-align: center;
      font-style: italic;
      color: #5c4a37;
      margin-bottom: 40px;
    }
    .section-group {
      margin-bottom: 44px;
    }
    .section-group:last-child {
      margin-bottom: 0;
    }
    .section-heading {
      text-align: left;
      color: var(--crust-dark, #5c4a37);
      font-size: 1.3rem;
      border-bottom: 1px solid var(--egg-wash);
      padding-bottom: 8px;
      margin: 0 0 20px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 28px;
    }
    .card {
      background: #fff;
      border-radius: 16px;
      padding: 24px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    .card .emoji {
      font-size: 2.6rem;
      margin-bottom: 10px;
    }
    .card .card-thumb {
      width: 100%;
      height: 140px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 14px;
      display: block;
    }
    .card h3 {
      margin: 6px 0;
      color: var(--crust);
    }
    .card a.recipe-link {
      display: inline-block;
      margin-top: 12px;
      color: #5c4a37;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .card a.recipe-link:hover { text-decoration: underline; }
    .about {
      display: flex;
      align-items: center;
      gap: 40px;
      flex-wrap: wrap;
    }
    .about img {
      width: 220px;
      height: 220px;
      object-fit: cover;
      object-position: top;
      border-radius: 50%;
      box-shadow: 0 6px 18px rgba(0,0,0,0.2);
    }
    .about-text { flex: 1; min-width: 260px; }
    blockquote {
      border-left: 4px solid var(--tomato);
      padding-left: 16px;
      font-style: italic;
      color: #5c4a37;
    }

    @media (max-width: 700px) {
      .hero { height: 62vh; min-height: 340px; }
      .hero-text { left: 5%; right: 5%; max-width: none; }
      .hero-text h1 { font-size: 1.9rem; }
      .hero-text p { font-size: 1rem; }
      section { padding: 24px 5%; }
      h2 { font-size: 1.7rem; }
      .about { flex-direction: column; text-align: center; gap: 20px; }
      .about img { width: 160px; height: 160px; }
    }
  </style>
</head>
<body>

<Header />

<div class="hero">
  <img src="/hero.jpg" alt="Bruce holding a fresh loaf of bread triumphantly" />
  <div class="hero-text">
    <h1>Sourdough So Good It's Almost Suspicious.</h1>
    <p>Handcrafted bread, baked daily by a man with absolutely nothing to comb but a whole lot to prove.</p>
    <a href="#menu" class="btn">See What's Baking &rarr;</a>
  </div>
</div>

<div class="tagline-banner">
  All bread lovingly brought to you by <strong>Bruce the Bald Baker</strong>
</div>

<section id="menu">
  <h2>What's Rising Today</h2>
  <p class="subhead">Every loaf is proofed longer than Bruce's hairline has been gone.</p>
  {recipesBySection.map((group) => (
    <div class="section-group">
      <h3 class="section-heading">{group.label}</h3>
      <div class="grid">
        {group.items.map((recipe) => (
          <div class="card">
            <img src={recipe.data.heroImage} alt={recipe.data.title} class="card-thumb" />
            <h3>{recipe.data.title}</h3>
            <p>{recipe.data.subtitle}</p>
            <a href={`/recipes/${recipe.id}/`} class="recipe-link">View recipe &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

{comingSoon.length > 0 && (
  <section id="coming-soon">
    <h2>Baking Soon</h2>
    <p class="subhead">Tested, approved, and waiting on their full write-up.</p>
    <div class="grid">
      {comingSoon.map((item) => (
        <div class="card">
          <img src={item.image} alt={item.title} class="card-thumb" />
          <h3>{item.title}</h3>
          <p>{item.teaser}</p>
          <a href={item.href} class="recipe-link">Sneak peek &rarr;</a>
        </div>
      ))}
    </div>
  </section>
)}

<section id="about" style="background: var(--wheat-100);">
  <div class="section-inner">
    <h2>Meet the Baker</h2>
    <p class="subhead">No hair. No worries. Just bread.</p>
    <div class="about">
      <img src="/hero.jpg" alt="Bruce the Bald Baker" />
      <div class="about-text">
        <p>Bruce started baking bread twenty years ago after one particularly stubborn loaf convinced him he'd found his calling. What began as a weekend hobby turned into a full-blown bakery obsession.</p>
        <blockquote>"They say a bald head reflects light. I like to think mine reflects glory — mostly the glory of a perfectly baked crust." — Bruce</blockquote>
        <p><a href="/about/" class="recipe-link">Read the full story, and what this site actually is &rarr;</a></p>
      </div>
    </div>
  </div>
</section>

<section id="sami">
  <h2>Meet Sami the Sourdough Sandwich</h2>
  <p class="subhead">Half loaf, half legend, entirely delicious.</p>
  <div class="grid">
    {recentStories.map((story) => (
      <div class="card">
        <div class="emoji">{story.data.mapPin.emoji}</div>
        <h3>{story.data.title.replace('Sami the Sourdough Sandwich ', '')}</h3>
        <p>{story.data.subtitle}</p>
        <a href={`/sami/${story.id}/`} class="recipe-link">Read the adventure &rarr;</a>
      </div>
    ))}
  </div>
  <p class="subhead" style="margin-top:32px;"><a href="/sami/" class="recipe-link">Meet the rest of Sami's family and see all of his adventures &rarr;</a></p>
</section>

<footer>
  <p>Bruce's Breads &middot; Fresh Bread, Fresh Puns, Zero Hair</p>
  <div class="signature">Bread proudly brought to you by Bruce the Bald Baker</div>
  <div class="fine-print">&copy; 2026 Bruce's Breads. All rights reserved. No baldness jokes were harmed in the making of this website (Bruce made most of them himself).</div>
</footer>

</body>
</html>
